# Project-facing quality values. Render-pass topology remains code-owned by Generic RP.
Version: 2
Pipeline: GenericRP
Name: Generic RP Default
Fallback:
  ClearColor:
    R: 1.0
    G: 0.4
    B: 0.7
    A: 1.0
Shadows:
  Enabled: true
  MapSize: 2048
  # Receiver comparison bias in normalized shadow depth.
  DepthBias: 0.00165
  SlopeBias: 0.00231
  Strength: 0.78
  PcfRadius: 1
  # Outdoor cascades share one depth-array allocation at this per-layer resolution.
  CascadeCount: 4
  MaximumDistance: 250.0
  # Blend between uniform (0) and logarithmic (1) camera-depth splits.
  PracticalSplitWeight: 0.65
  # Fade the final cascade over the terminal fraction of MaximumDistance.
  TerminalFadeFraction: 0.10
